<resources>
    <style name="TextAppearance.TumblrDownloader.PopupMenu" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/popup_menu_text</item>
    </style>

    <style name="Theme.TumblrDownloader" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/purple_100</item>
        <item name="colorOnPrimaryContainer">@color/purple_900</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorSecondaryContainer">@color/teal_100</item>
        <item name="colorOnSecondaryContainer">@color/teal_900</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/black</item>
        <item name="textAppearanceLargePopupMenu">@style/TextAppearance.TumblrDownloader.PopupMenu</item>
        <item name="textAppearanceSmallPopupMenu">@style/TextAppearance.TumblrDownloader.PopupMenu</item>
        <item name="android:statusBarColor">?attr/colorPrimary</item>
    </style>
</resources>