<?xml version="1.0" encoding="utf-8"?>
<!-- Floating pill background for the bottom navigation bar.
     Horizontal insets come from the layout margins in Phase 1. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/aurora_glass_fill_nav" />
    <stroke
        android:width="1dp"
        android:color="@color/aurora_glass_stroke" />
    <corners android:radius="100dp" />
</shape>
